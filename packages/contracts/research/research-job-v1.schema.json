{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/research/research-job-v1.schema.json",
  "title": "MOOYU Research Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "jobId", "topicId", "contractVersion", "trigger", "requestedAt", "gap", "contract", "methodTemplates", "metricDefinitions", "knownSourceVersions", "evidence"],
  "properties": {
    "protocol": { "const": "research-job-v1" },
    "jobId": { "type": "string", "format": "uuid" },
    "topicId": { "type": "string", "format": "uuid" },
    "contractVersion": { "type": "integer", "minimum": 1 },
    "trigger": { "enum": ["manual", "scheduled", "backfill"] },
    "requestedAt": { "type": "string", "format": "date-time" },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gapId", "question", "reason", "priority"],
      "properties": {
        "gapId": { "type": "string", "format": "uuid" },
        "question": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "priority": { "enum": ["routine", "important", "critical"] }
      }
    },
    "contract": { "$ref": "./research-contract-v1.schema.json" },
    "methodTemplates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "methodVersion", "label", "description", "methodKind", "rules"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "methodVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "methodKind": { "const": "direct-observation" },
          "rules": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidenceKinds", "authorityTiers", "requiredDimensions", "missingValuePolicy", "comparisonPolicy", "aggregation", "instructions"],
            "properties": {
              "evidenceKinds": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["change-excerpt", "direct-quote", "structured-fact", "metadata"] } },
              "authorityTiers": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "enum": ["official-primary", "official-implementation", "institutional", "independent-reputable", "community", "unknown"] } },
              "requiredDimensions": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$" } },
              "missingValuePolicy": { "const": "unknown" },
              "comparisonPolicy": { "const": "same-method-unit" },
              "aggregation": { "const": "none" },
              "instructions": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        }
      }
    },
    "metricDefinitions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metricKey", "label", "valueType", "canonicalUnit", "methodVersion"],
        "properties": {
          "metricKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "valueType": { "enum": ["number", "text"] },
          "canonicalUnit": { "type": "string", "minLength": 1, "maxLength": 40 },
          "methodVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" }
        }
      }
    },
    "knownSourceVersions": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "sourceVersionId", "url", "contentHash", "fetchedAt", "authorityTier"],
        "properties": {
          "sourceId": { "type": "string", "format": "uuid" },
          "sourceVersionId": { "type": "string", "format": "uuid" },
          "url": { "type": "string", "format": "uri", "maxLength": 2048 },
          "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "fetchedAt": { "type": "string", "format": "date-time" },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "authorityTier": { "enum": ["official-primary", "official-implementation", "institutional", "independent-reputable", "community", "unknown"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "sourceId", "sourceVersionId", "url", "contentHash", "quoteHash", "locator", "quote", "kind", "authorityTier"],
        "properties": {
          "evidenceId": { "type": "string", "format": "uuid" },
          "sourceId": { "type": "string", "format": "uuid" },
          "sourceVersionId": { "type": "string", "format": "uuid" },
          "url": { "type": "string", "format": "uri", "maxLength": 2048 },
          "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "quoteHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "locator": { "type": "object" },
          "quote": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "kind": { "enum": ["change-excerpt", "direct-quote", "structured-fact", "metadata"] },
          "authorityTier": { "enum": ["official-primary", "official-implementation", "institutional", "independent-reputable", "community", "unknown"] }
        }
      }
    }
  }
}
