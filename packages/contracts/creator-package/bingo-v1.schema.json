{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/creator-package/bingo-v1.json",
  "title": "GameHub Bingo Source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tableTitle", "columnHeaders", "rowHeaders", "cells"],
  "properties": {
    "tableTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
    "subtitle": { "type": "string", "maxLength": 160 },
    "columnHeaders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "rowHeaders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "cells": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]+:[0-9]+$" },
      "additionalProperties": { "type": "string", "maxLength": 200 }
    }
  }
}
