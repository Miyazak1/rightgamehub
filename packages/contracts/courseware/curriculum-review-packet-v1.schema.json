{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/courseware/curriculum-review-packet-v1.schema.json",
  "title": "MOOYU Curriculum Review Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "id", "catalogId", "catalogDigest", "briefId", "subjectId", "clusterId", "status", "reviewPolicy", "nodeReviews", "relationReviews", "clusterReview", "textbookMappingIntake", "releaseConditions"],
  "properties": {
    "format": { "const": "mooyu.curriculum-review-packet" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "catalogId": { "$ref": "#/$defs/id" },
    "catalogDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "briefId": { "$ref": "#/$defs/id" },
    "subjectId": { "$ref": "#/$defs/id" },
    "clusterId": { "$ref": "#/$defs/id" },
    "status": { "enum": ["pending", "in-review", "changes-requested", "approved"] },
    "reviewPolicy": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localizedText" } },
    "nodeReviews": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nodeReview" } },
    "relationReviews": { "type": "array", "items": { "$ref": "#/$defs/relationReview" } },
    "clusterReview": { "$ref": "#/$defs/clusterReview" },
    "textbookMappingIntake": { "$ref": "#/$defs/textbookMappingIntake" },
    "releaseConditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localizedText" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "localizedText": { "type": "object", "additionalProperties": false, "required": ["zh-CN", "en"], "properties": { "zh-CN": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } } },
    "sourceRef": { "type": "object", "additionalProperties": false, "required": ["authorityId", "locator", "scope"], "properties": { "authorityId": { "$ref": "#/$defs/id" }, "locator": { "type": "string", "minLength": 1 }, "scope": { "enum": ["verbatim", "normalized", "inferred"] }, "quote": { "type": "string" } } },
    "check": { "type": "object", "additionalProperties": false, "required": ["code", "label", "required", "status"], "properties": { "code": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/localizedText" }, "required": { "type": "boolean" }, "status": { "enum": ["pending", "pass", "changes-requested", "not-applicable"] } } },
    "nodeReview": {
      "type": "object", "additionalProperties": false, "required": ["nodeId", "title", "type", "curriculumLevels", "sourceRefs", "representations", "observableVariables", "interactionCandidates", "misconceptions", "checks"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/localizedText" }, "type": { "type": "string" }, "parentId": { "$ref": "#/$defs/id" },
        "curriculumLevels": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "representations": { "type": "array", "items": { "type": "string" } }, "observableVariables": { "type": "array", "items": { "type": "string" } },
        "interactionCandidates": { "$ref": "#/$defs/idList" }, "misconceptions": { "type": "array", "items": { "$ref": "#/$defs/localizedText" } }, "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } }
      }
    },
    "relationReview": { "type": "object", "additionalProperties": false, "required": ["relationId", "type", "fromNodeId", "toNodeId", "scope", "sourceRefs", "checks"], "properties": { "relationId": { "$ref": "#/$defs/id" }, "type": { "type": "string" }, "fromNodeId": { "$ref": "#/$defs/id" }, "toNodeId": { "$ref": "#/$defs/id" }, "scope": { "enum": ["internal", "inbound", "outbound"] }, "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } }, "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } } } },
    "clusterReview": { "type": "object", "additionalProperties": false, "required": ["title", "coreNodeIds", "runtimeRequirements", "checks"], "properties": { "title": { "$ref": "#/$defs/localizedText" }, "coreNodeIds": { "$ref": "#/$defs/idList" }, "runtimeRequirements": { "$ref": "#/$defs/idList" }, "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } } } },
    "textbookMappingSummary": { "type": "object", "additionalProperties": false, "required": ["mappingId", "publisher", "edition", "locator"], "properties": { "mappingId": { "$ref": "#/$defs/id" }, "publisher": { "type": "string", "minLength": 1 }, "edition": { "type": "string", "minLength": 1 }, "locator": { "type": "string", "minLength": 1 } } },
    "textbookRow": { "type": "object", "additionalProperties": false, "required": ["nodeId", "status", "mappings"], "properties": { "nodeId": { "$ref": "#/$defs/id" }, "status": { "enum": ["pending", "mapped", "not-present", "needs-split"] }, "mappings": { "type": "array", "items": { "$ref": "#/$defs/textbookMappingSummary" } } } },
    "textbookMappingIntake": { "type": "object", "additionalProperties": false, "required": ["status", "requiredEditionFields", "nodeRows"], "properties": { "status": { "enum": ["edition-not-selected", "mapping-in-progress", "complete"] }, "requiredEditionFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["publisher", "edition", "volume", "chapter", "section", "page-range", "isbn-or-catalog-id"] } }, "nodeRows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/textbookRow" } } } }
  }
}
