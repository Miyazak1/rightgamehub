{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/courseware/mission-v1.schema.json",
  "title": "MOOYU Composite Learning Mission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "id", "version", "title", "initialNodeId", "capabilitySlots", "clocks", "resources", "nodes", "outcomes"],
  "properties": {
    "format": { "const": "mooyu.learning-mission" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "title": { "$ref": "#/$defs/localizedText" },
    "initialNodeId": { "$ref": "#/$defs/id" },
    "capabilitySlots": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "clocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/meter" }
    },
    "resources": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/meter" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/node" }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/outcome" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 12,
      "propertyNames": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][A-Za-z0-9]{1,7})?$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "meter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "initial", "minimum", "maximum"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "initial": { "type": "number" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "costMap": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id", "operator"],
      "properties": {
        "source": { "enum": ["metric", "resource", "clock", "state", "evidence"] },
        "id": { "$ref": "#/$defs/id" },
        "operator": { "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "between", "truthy", "falsy"] },
        "value": { "type": ["number", "string", "boolean"] },
        "values": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to"],
      "properties": {
        "to": { "$ref": "#/$defs/id" },
        "when": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/condition" } }
      }
    },
    "evidenceEmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "kind"],
      "properties": {
        "claimId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["prediction", "calculation", "configuration", "measurement", "comparison", "explanation", "transfer"] },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "success", "onSuccess"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/localizedText" },
        "clockCosts": { "$ref": "#/$defs/costMap" },
        "resourceCosts": { "$ref": "#/$defs/costMap" },
        "success": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/condition" } },
        "onSuccess": { "$ref": "#/$defs/transition" },
        "onFailure": { "$ref": "#/$defs/transition" },
        "evidence": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/evidenceEmission" } }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["briefing", "calculation", "construction", "simulation", "decision", "checkpoint", "debrief"] },
        "title": { "$ref": "#/$defs/localizedText" },
        "capabilitySlots": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "actions": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/action" } }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "when"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["success", "partial", "failure"] },
        "title": { "$ref": "#/$defs/localizedText" },
        "when": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/condition" } }
      }
    }
  }
}
