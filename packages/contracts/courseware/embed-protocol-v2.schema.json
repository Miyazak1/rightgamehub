{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/courseware/embed-protocol-v2.schema.json",
  "title": "MOOYU Courseware Embed Protocol v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "type", "id", "name", "payload"],
  "properties": {
    "protocol": { "const": "mooyu.courseware.embed.v2" },
    "version": { "const": 2 },
    "type": { "enum": ["connect", "connected", "event", "command", "response", "error"] },
    "id": { "$ref": "#/$defs/uuid" },
    "name": { "enum": ["host.connect", "courseware.connected", "courseware.ready", "courseware.started", "scene.entered", "checkpoint.attempted", "objective.completed", "courseware.completed", "courseware.resized", "courseware.error", "host.setLocale", "host.setTheme", "host.setMotion", "host.pause", "host.resume", "host.restoreProgress", "host.exportProgress", "host.setExperience", "host.restoreState", "host.exportState", "EMBED_MESSAGE_INVALID", "EMBED_ORIGIN_DENIED", "EMBED_RELEASE_UNAVAILABLE", "EMBED_RATE_LIMITED", "EMBED_COMMAND_UNSUPPORTED", "EMBED_PROGRESS_INVALID", "EMBED_STATE_INVALID"] },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "name": { "const": "host.connect" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "connect" }, "payload": { "$ref": "#/$defs/connect" } } } },
    { "if": { "properties": { "name": { "const": "courseware.connected" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "connected" }, "payload": { "$ref": "#/$defs/connected" } } } },
    { "if": { "properties": { "name": { "const": "courseware.ready" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "event" }, "payload": { "$ref": "#/$defs/ready" } } } },
    { "if": { "properties": { "name": { "const": "courseware.started" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "event" }, "payload": { "$ref": "#/$defs/started" } } } },
    { "if": { "properties": { "name": { "const": "scene.entered" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "event" }, "payload": { "$ref": "#/$defs/scene" } } } },
    { "if": { "properties": { "name": { "const": "checkpoint.attempted" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "event" }, "payload": { "$ref": "#/$defs/checkpoint" } } } },
    { "if": { "properties": { "name": { "const": "objective.completed" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "event" }, "payload": { "$ref": "#/$defs/objective" } } } },
    { "if": { "properties": { "name": { "const": "courseware.completed" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "event" }, "payload": { "$ref": "#/$defs/completed" } } } },
    { "if": { "properties": { "name": { "const": "courseware.resized" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "event" }, "payload": { "$ref": "#/$defs/resized" } } } },
    { "if": { "properties": { "name": { "const": "courseware.error" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "event" }, "payload": { "$ref": "#/$defs/coursewareError" } } } },
    { "if": { "properties": { "name": { "const": "host.setLocale" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "command" }, "payload": { "$ref": "#/$defs/locale" } } } },
    { "if": { "properties": { "name": { "const": "host.setTheme" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "command" }, "payload": { "$ref": "#/$defs/theme" } } } },
    { "if": { "properties": { "name": { "const": "host.setMotion" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "command" }, "payload": { "$ref": "#/$defs/motion" } } } },
    { "if": { "properties": { "name": { "const": "host.setExperience" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "command" }, "payload": { "$ref": "#/$defs/experience" } } } },
    { "if": { "properties": { "name": { "enum": ["host.pause", "host.resume"] } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "command" }, "payload": { "$ref": "#/$defs/empty" } } } },
    { "if": { "properties": { "name": { "const": "host.restoreProgress" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "command" }, "payload": { "$ref": "#/$defs/progress" } } } },
    { "if": { "properties": { "name": { "const": "host.restoreState" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "command" }, "payload": { "$ref": "#/$defs/state" } } } },
    { "if": { "properties": { "name": { "enum": ["host.exportProgress", "host.exportState"] }, "type": { "const": "command" } }, "required": ["name", "type"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/empty" } } } },
    { "if": { "properties": { "name": { "const": "host.exportProgress" }, "type": { "const": "response" } }, "required": ["name", "type"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/progress" } } } },
    { "if": { "properties": { "name": { "const": "host.exportState" }, "type": { "const": "response" } }, "required": ["name", "type"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/state" } } } },
    { "if": { "properties": { "name": { "pattern": "^EMBED_" } }, "required": ["name"] }, "then": { "properties": { "type": { "const": "error" }, "payload": { "$ref": "#/$defs/error" } } } }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "empty": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "connect": { "type": "object", "additionalProperties": false, "required": ["nonce"], "properties": { "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" } } },
    "connected": { "type": "object", "additionalProperties": false, "required": ["connectionId", "nonce"], "properties": { "connectionId": { "$ref": "#/$defs/uuid" }, "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" } } },
    "ready": { "type": "object", "additionalProperties": false, "required": ["workId", "releaseId", "locale", "capabilities"], "properties": { "workId": { "$ref": "#/$defs/uuid" }, "releaseId": { "$ref": "#/$defs/uuid" }, "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" }, "capabilities": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "enum": ["learningProgress", "learningEvents", "assessmentResult", "fullscreen", "fileExport", "stateSnapshot", "experienceMode"] } } } },
    "started": { "type": "object", "additionalProperties": false, "required": ["startedAt"], "properties": { "startedAt": { "type": "string", "format": "date-time" } } },
    "scene": { "type": "object", "additionalProperties": false, "required": ["sceneId"], "properties": { "sceneId": { "$ref": "#/$defs/id" } } },
    "checkpoint": { "type": "object", "additionalProperties": false, "required": ["checkpointId", "attempt", "outcome"], "properties": { "checkpointId": { "$ref": "#/$defs/id" }, "attempt": { "type": "integer", "minimum": 1, "maximum": 10000 }, "outcome": { "enum": ["correct", "incorrect", "skipped"] } } },
    "objective": { "type": "object", "additionalProperties": false, "required": ["objectiveId", "completedAt"], "properties": { "objectiveId": { "$ref": "#/$defs/id" }, "completedAt": { "type": "string", "format": "date-time" } } },
    "completed": { "type": "object", "additionalProperties": false, "required": ["objectiveIds", "checkpointSummary", "durationBucket"], "properties": { "objectiveIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "checkpointSummary": { "type": "object", "additionalProperties": false, "required": ["attempted", "correct"], "properties": { "attempted": { "type": "integer", "minimum": 0 }, "correct": { "type": "integer", "minimum": 0 } } }, "durationBucket": { "enum": ["under-1m", "1-5m", "5-15m", "15-30m", "over-30m", "unknown"] } } },
    "resized": { "type": "object", "additionalProperties": false, "required": ["height", "aspectRatio"], "properties": { "height": { "type": "integer", "minimum": 200, "maximum": 10000 }, "aspectRatio": { "type": "string", "pattern": "^[1-9][0-9]{0,3}/[1-9][0-9]{0,3}$" } } },
    "coursewareError": { "type": "object", "additionalProperties": false, "required": ["code", "recoverable"], "properties": { "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }, "recoverable": { "type": "boolean" } } },
    "locale": { "type": "object", "additionalProperties": false, "required": ["locale"], "properties": { "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" } } },
    "theme": { "type": "object", "additionalProperties": false, "required": ["theme"], "properties": { "theme": { "enum": ["light", "dark", "system"] } } },
    "motion": { "type": "object", "additionalProperties": false, "required": ["motion"], "properties": { "motion": { "enum": ["full", "reduced", "system"] } } },
    "experience": { "type": "object", "additionalProperties": false, "required": ["modeId"], "properties": { "modeId": { "$ref": "#/$defs/id" } } },
    "progress": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "workId", "releaseId", "completedSceneIds", "completedCheckpointIds", "completedObjectiveIds"], "properties": { "schemaVersion": { "const": 1 }, "workId": { "$ref": "#/$defs/uuid" }, "releaseId": { "$ref": "#/$defs/uuid" }, "completedSceneIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "completedCheckpointIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "completedObjectiveIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "scalar": { "oneOf": [{ "type": "boolean" }, { "type": "number" }, { "type": "string", "maxLength": 256 }] },
    "variables": { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/scalar" } },
    "object": { "type": "object", "additionalProperties": false, "required": ["id", "type", "x", "y", "properties"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "$ref": "#/$defs/id" }, "x": { "type": "number" }, "y": { "type": "number" }, "properties": { "$ref": "#/$defs/variables" } } },
    "state": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "workId", "releaseId", "sceneId", "experienceMode", "variables", "objects", "progress"], "properties": { "schemaVersion": { "const": 1 }, "workId": { "$ref": "#/$defs/uuid" }, "releaseId": { "$ref": "#/$defs/uuid" }, "sceneId": { "$ref": "#/$defs/id" }, "experienceMode": { "$ref": "#/$defs/id" }, "variables": { "$ref": "#/$defs/variables" }, "objects": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/object" } }, "progress": { "$ref": "#/$defs/progress" } } },
    "error": { "type": "object", "additionalProperties": false, "required": ["recoverable"], "properties": { "recoverable": { "type": "boolean" } } }
  }
}
