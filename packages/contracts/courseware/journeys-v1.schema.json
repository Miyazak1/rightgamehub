{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/courseware/journeys-v1.schema.json",
  "title": "MOOYU Courseware Learning Journeys v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "journeys"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "journeys": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/journey" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "journey": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "locale", "steps", "expectsCompletion"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1, "maxLength": 200 }, "locale": { "type": "string", "minLength": 2, "maxLength": 24 },
        "steps": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/step" } }, "expectsCompletion": { "type": "boolean" }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["action", "target"],
      "properties": {
        "action": { "enum": ["enter", "set", "click", "answer", "assert", "complete"] }, "target": { "$ref": "#/$defs/id" },
        "value": {}, "expect": {}
      }
    }
  }
}
