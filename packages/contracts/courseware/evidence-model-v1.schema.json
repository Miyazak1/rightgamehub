{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/courseware/evidence-model-v1.schema.json",
  "title": "MOOYU Learning Evidence Model v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "id", "objectiveIds", "claims"],
  "properties": {
    "format": { "const": "mooyu.learning-evidence-model" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "objectiveIds": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objectiveId", "kind", "weight", "minimumStrength"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "objectiveId": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["prediction", "calculation", "configuration", "measurement", "comparison", "explanation", "transfer"] },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
          "minimumStrength": { "type": "number", "minimum": 0, "maximum": 1 },
          "required": { "type": "boolean", "default": false }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" }
  }
}
