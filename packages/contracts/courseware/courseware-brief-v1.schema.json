{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/courseware/courseware-brief-v1.schema.json",
  "title": "MOOYU Courseware Pre-production Brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "id", "subjectId", "clusterId", "title", "status", "targetDepth", "knowledgeNodeIds", "blockingGates", "runtimeRequirements", "learning", "model", "instruments", "scenes", "checkpoints", "acceptance"],
  "properties": {
    "format": { "const": "mooyu.courseware-brief" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "subjectId": { "$ref": "#/$defs/id" },
    "clusterId": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/localizedText" },
    "status": { "enum": ["review-blocked", "ready", "building", "accepted"] },
    "targetDepth": { "enum": ["C4", "C5"] },
    "knowledgeNodeIds": { "$ref": "#/$defs/idList" },
    "blockingGates": { "type": "array", "uniqueItems": true, "items": { "enum": ["subject-review", "textbook-mapping"] } },
    "runtimeRequirements": { "$ref": "#/$defs/idList" },
    "learning": {
      "type": "object", "additionalProperties": false, "required": ["objectives", "prerequisites", "misconceptions"],
      "properties": {
        "objectives": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/objective" } },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/localizedText" } },
        "misconceptions": { "type": "array", "items": { "$ref": "#/$defs/misconception" } }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false, "required": ["stateVariables", "commands", "derivedViews", "invariants"],
      "properties": {
        "stateVariables": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stateVariable" } },
        "commands": { "$ref": "#/$defs/idList" },
        "derivedViews": { "$ref": "#/$defs/idList" },
        "invariants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localizedText" } }
      }
    },
    "instruments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/instrument" } },
    "scenes": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/scene" } },
    "checkpoints": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/checkpoint" } },
    "acceptance": {
      "type": "object", "additionalProperties": false, "required": ["journeys", "embedHosts", "keyboardComplete", "reducedMotion", "accessibility"],
      "properties": {
        "journeys": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/journey" } },
        "embedHosts": { "type": "integer", "minimum": 2 },
        "keyboardComplete": { "const": true },
        "reducedMotion": { "const": true },
        "accessibility": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localizedText" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "idList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "localizedText": { "type": "object", "additionalProperties": false, "required": ["zh-CN", "en"], "properties": { "zh-CN": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } } },
    "objective": { "type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/localizedText" } } },
    "misconception": { "type": "object", "additionalProperties": false, "required": ["id", "text", "objectiveIds"], "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/localizedText" }, "objectiveIds": { "$ref": "#/$defs/idList" } } },
    "stateVariable": { "type": "object", "additionalProperties": false, "required": ["id", "type", "default"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["number", "integer", "boolean", "enum", "vector", "series"] }, "unit": { "type": "string" }, "minimum": { "type": "number" }, "maximum": { "type": "number" }, "default": {} } },
    "instrument": { "type": "object", "additionalProperties": false, "required": ["id", "type", "observes"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "$ref": "#/$defs/id" }, "observes": { "$ref": "#/$defs/idList" } } },
    "scene": { "type": "object", "additionalProperties": false, "required": ["id", "type", "title", "objectiveIds", "instrumentIds"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["explain", "explore", "simulate", "practice", "assess", "reflect"] }, "title": { "$ref": "#/$defs/localizedText" }, "objectiveIds": { "$ref": "#/$defs/idList" }, "instrumentIds": { "$ref": "#/$defs/idList" } } },
    "checkpoint": { "type": "object", "additionalProperties": false, "required": ["id", "sceneId", "kind", "prompt", "objectiveIds", "successEvidence"], "properties": { "id": { "$ref": "#/$defs/id" }, "sceneId": { "$ref": "#/$defs/id" }, "kind": { "enum": ["observation", "prediction", "multiple-choice", "numeric", "ordering", "free-response"] }, "prompt": { "$ref": "#/$defs/localizedText" }, "objectiveIds": { "$ref": "#/$defs/idList" }, "successEvidence": { "$ref": "#/$defs/localizedText" } } },
    "journey": { "type": "object", "additionalProperties": false, "required": ["id", "locale", "steps"], "properties": { "id": { "$ref": "#/$defs/id" }, "locale": { "enum": ["zh-CN", "en"] }, "steps": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } } } }
  }
}
