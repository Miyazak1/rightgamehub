{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/courseware/course-v1.schema.json",
  "title": "MOOYU Course Structure v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "objectives", "prerequisites", "misconceptions", "scenes", "checkpoints", "completion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "objectives": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/objective" } },
    "prerequisites": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/localizedText" } },
    "misconceptions": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/misconception" } },
    "scenes": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/scene" } },
    "checkpoints": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/checkpoint" } },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectiveIds", "checkpointIds"],
      "properties": {
        "objectiveIds": { "$ref": "#/$defs/idList" },
        "checkpointIds": { "$ref": "#/$defs/idList" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "idList": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "localizedText": { "type": "object", "minProperties": 1, "maxProperties": 12, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 1200 } },
    "objective": {
      "type": "object", "additionalProperties": false, "required": ["id", "text"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/localizedText" } }
    },
    "misconception": {
      "type": "object", "additionalProperties": false, "required": ["id", "text", "objectiveIds"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/localizedText" }, "objectiveIds": { "$ref": "#/$defs/idList" } }
    },
    "scene": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "title", "objectiveIds", "evidenceIds", "component", "fallback"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["explain", "explore", "simulate", "practice", "assess", "reflect"] },
        "title": { "$ref": "#/$defs/localizedText" },
        "objectiveIds": { "$ref": "#/$defs/idList" },
        "evidenceIds": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "component": {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": { "type": { "$ref": "#/$defs/id" }, "config": { "type": "object" } }
        },
        "fallback": { "$ref": "#/$defs/localizedText" }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false, "required": ["id", "sceneId", "objectiveIds", "kind", "prompt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "sceneId": { "$ref": "#/$defs/id" }, "objectiveIds": { "$ref": "#/$defs/idList" },
        "kind": { "enum": ["observation", "prediction", "multiple-choice", "numeric", "ordering", "free-response"] },
        "prompt": { "$ref": "#/$defs/localizedText" }, "answer": {}
      }
    }
  }
}
