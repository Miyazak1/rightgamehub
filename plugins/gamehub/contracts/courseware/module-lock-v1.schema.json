{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/courseware/module-lock-v1.schema.json",
  "title": "MOOYU Courseware Module Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "runtimeApiVersion", "roots", "modules"],
  "properties": {
    "format": { "const": "mooyu.courseware-module-lock" },
    "schemaVersion": { "const": 1 },
    "runtimeApiVersion": { "const": 1 },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifest", "entry", "manifestIntegrity", "module"],
        "properties": {
          "manifest": { "$ref": "#/$defs/jsonPath" },
          "entry": { "$ref": "#/$defs/modulePath" },
          "manifestIntegrity": { "$ref": "#/$defs/integrity" },
          "module": { "$ref": "module-manifest-v1.schema.json" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "jsonPath": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$" },
    "modulePath": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/-]*\\.mjs$" },
    "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
