{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/courseware/textbook-baseline-v1.schema.json",
  "title": "MOOYU Curriculum Textbook Baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "id", "checkedAt", "jurisdiction", "educationStage", "selectionPolicy", "scopeNote", "authorities", "editions"],
  "properties": {
    "format": { "const": "mooyu.curriculum-textbook-baseline" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "checkedAt": { "type": "string", "format": "date" },
    "jurisdiction": { "const": "CN" },
    "educationStage": { "const": "upper-secondary" },
    "selectionPolicy": { "enum": ["platform-first-baseline", "regional-adoption"] },
    "scopeNote": { "$ref": "#/$defs/localizedText" },
    "authorities": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/authority" } },
    "editions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/edition" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh-CN", "en"],
      "properties": {
        "zh-CN": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "en": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "issuer", "sourceUrl"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["national-catalog", "regional-adoption-catalog", "publisher-catalog", "official-digital-textbook", "publisher-resource"] },
        "title": { "$ref": "#/$defs/localizedText" },
        "issuer": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceUrl": { "type": "string", "format": "uri", "maxLength": 2000 }
      }
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subjectId", "publisher", "curriculumFamily", "title", "volume", "editionLabel", "catalogLocator", "authorityIds", "sourceUrls"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subjectId": { "enum": ["mathematics", "physics", "chemistry"] },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 200 },
        "curriculumFamily": { "type": "string", "minLength": 1, "maxLength": 200 },
        "title": { "$ref": "#/$defs/localizedText" },
        "volume": { "type": "string", "minLength": 1, "maxLength": 120 },
        "editionLabel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "catalogLocator": { "type": "string", "minLength": 1, "maxLength": 500 },
        "isbn": { "type": "string", "pattern": "^978-[0-9]-[0-9]{3}-[0-9]{5}-[0-9]$" },
        "authorityIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "sourceUrls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri", "maxLength": 2000 } }
      }
    }
  }
}
