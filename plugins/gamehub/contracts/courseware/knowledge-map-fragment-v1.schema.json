{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/courseware/knowledge-map-fragment-v1.schema.json",
  "title": "MOOYU Curriculum Knowledge Map Fragment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "id", "subjectId", "nodes", "relations", "clusters", "textbookMappings", "review"],
  "properties": {
    "format": { "const": "mooyu.curriculum-knowledge-map-fragment" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "subjectId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "nodes": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "knowledge-map-v1.schema.json#/$defs/node" } },
    "relations": { "type": "array", "maxItems": 50000, "items": { "$ref": "knowledge-map-v1.schema.json#/$defs/relation" } },
    "clusters": { "type": "array", "maxItems": 2000, "items": { "$ref": "knowledge-map-v1.schema.json#/$defs/cluster" } },
    "textbookMappings": { "type": "array", "maxItems": 20000, "items": { "$ref": "knowledge-map-v1.schema.json#/$defs/textbookMapping" } },
    "review": { "$ref": "knowledge-map-v1.schema.json#/$defs/review" }
  }
}
