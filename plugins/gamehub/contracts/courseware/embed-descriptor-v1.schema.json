{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/courseware/embed-descriptor-v1.schema.json",
  "title": "MOOYU Courseware Embed Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workId", "releaseId", "channel", "title", "embedUrl", "aspectRatio", "locales", "capabilities", "releaseDigest", "publishedAt", "embedStatus", "sourcePolicy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workId": { "type": "string", "format": "uuid" },
    "releaseId": { "type": "string", "format": "uuid" },
    "channel": { "enum": ["fixed", "current"] },
    "title": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": { "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "embedUrl": { "type": "string", "format": "uri", "pattern": "^https://embed\\.mooyu\\.fun/v1/works/" },
    "aspectRatio": { "type": "string", "pattern": "^[1-9][0-9]{0,3}/[1-9][0-9]{0,3}$" },
    "locales": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" } },
    "capabilities": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "enum": ["fullscreen", "learningProgress", "learningEvents", "assessmentResult", "fileExport"] } },
    "releaseDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "embedStatus": { "enum": ["public", "disabled", "withdrawn", "suspended", "revoked"] },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["public-https", "allowlist", "disabled"] },
        "origins": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "allowlist" } }, "required": ["mode"] }, "then": { "required": ["origins"], "properties": { "origins": { "minItems": 1 } } } }
      ]
    }
  },
  "allOf": [
    { "if": { "properties": { "channel": { "const": "fixed" } }, "required": ["channel"] }, "then": { "properties": { "embedUrl": { "pattern": "^https://embed\\.mooyu\\.fun/v1/works/[0-9a-f-]+/releases/[0-9a-f-]+$" } } } },
    { "if": { "properties": { "channel": { "const": "current" } }, "required": ["channel"] }, "then": { "properties": { "embedUrl": { "pattern": "^https://embed\\.mooyu\\.fun/v1/works/[0-9a-f-]+\\?channel=current$" } } } }
  ]
}
