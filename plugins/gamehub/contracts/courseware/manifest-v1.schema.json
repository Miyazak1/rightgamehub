{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooyu.fun/schemas/courseware/manifest-v1.schema.json",
  "title": "MOOYU Courseware Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "id", "title", "defaultLocale", "locales", "subjects", "audience", "course", "evidence", "tests", "build", "runtime", "licenses"],
  "properties": {
    "format": { "const": "mooyu.courseware" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/localizedText" },
    "summary": { "$ref": "#/$defs/localizedText" },
    "defaultLocale": { "$ref": "#/$defs/locale" },
    "locales": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/locale" } },
    "subjects": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages"],
      "properties": {
        "stages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["primary", "lower-secondary", "upper-secondary", "higher-education", "professional", "lifelong"] } },
        "minimumAge": { "type": "integer", "minimum": 3, "maximum": 120 },
        "maximumAge": { "type": "integer", "minimum": 3, "maximum": 120 }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "topic", "estimatedMinutes", "cover"],
      "properties": {
        "category": { "enum": ["simulations", "practice", "tools", "topics"] },
        "topic": { "$ref": "#/$defs/localizedText" },
        "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 240 },
        "order": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "cover": {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbol", "tone"],
          "properties": {
            "symbol": { "type": "string", "minLength": 1, "maxLength": 40 },
            "tone": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "course": { "$ref": "#/$defs/localPath" },
    "evidence": { "$ref": "#/$defs/localPath" },
    "tests": { "$ref": "#/$defs/localPath" },
    "experience": { "$ref": "#/$defs/localPath" },
    "mission": { "$ref": "#/$defs/localPath" },
    "capabilityBindings": { "$ref": "#/$defs/localPath" },
    "evidenceModel": { "$ref": "#/$defs/localPath" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "entry"],
      "properties": {
        "profile": { "enum": ["mooyu-static-v1", "mooyu-structured-v1"] },
        "entry": { "const": "dist/index.html" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "learningSdk", "capabilities"],
      "properties": {
        "kind": { "enum": ["static-web", "static-wasm"] },
        "learningSdk": { "const": 1 },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["fullscreen", "pointerLock", "localSave", "fileExport", "shareLinks", "learningProgress", "learningEvents", "assessmentResult"] } },
        "profile": { "enum": ["legacy-web", "structured-courseware"] },
        "modules": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/jsonPath" } },
        "rootModules": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/moduleId" } },
        "moduleLock": { "const": "dist/mooyu-modules.lock.json" }
      }
    },
    "licenses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "content"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 80 },
        "content": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "build": { "properties": { "profile": { "const": "mooyu-structured-v1" } }, "required": ["profile"] } }, "required": ["build"] },
      "then": {
        "properties": {
          "runtime": {
            "required": ["kind", "learningSdk", "capabilities", "profile", "modules", "rootModules", "moduleLock"],
            "properties": { "profile": { "const": "structured-courseware" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][A-Za-z0-9]{1,7})?$", "maxLength": 24 },
    "localPath": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "jsonPath": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$" },
    "moduleId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 12,
      "propertyNames": { "$ref": "#/$defs/locale" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  }
}
