{
  "format": "mooyu.courseware-experience",
  "schemaVersion": 1,
  "engine": {
    "id": "gas-equilibrium-reactor",
    "version": 1,
    "deterministic": true,
    "snapshot": true,
    "stateVariables": ["volume", "temperature", "equilibrium-constant", "total-units", "catalyst", "n2o4", "no2", "reaction-quotient", "progress"]
  },
  "defaultMode": "textbook",
  "defaultView": "explore",
  "views": [
    { "id": "explore", "kind": "explore", "title": { "zh-CN": "探索", "en": "Explore" }, "purpose": { "zh-CN": "改变反应条件并观察粒子组成与平衡移动。", "en": "Change reaction conditions and observe composition and equilibrium shifts." }, "instrumentIds": ["particle-view", "qk-meter", "history", "replay"] },
    { "id": "model", "kind": "model", "title": { "zh-CN": "建模", "en": "Model" }, "purpose": { "zh-CN": "用 Q、K 和因果链解释体积、温度与催化剂的作用。", "en": "Explain volume, temperature, and catalyst effects through Q, K, and causal links." }, "instrumentIds": ["particle-view", "qk-meter"] },
    { "id": "analyse", "kind": "analyse", "title": { "zh-CN": "分析", "en": "Analyse" }, "purpose": { "zh-CN": "比较组成曲线、条件记录和反应器快照。", "en": "Compare composition curves, condition records, and reactor snapshots." }, "instrumentIds": ["table", "history", "comparison"] }
  ],
  "modes": [
    {
      "id": "textbook",
      "kind": "textbook-lab",
      "title": { "zh-CN": "教材实验", "en": "Textbook Lab" },
      "sceneIds": ["control-equilibrium"],
      "freedomLevel": "F1",
      "allowedCommands": ["object.configure", "simulation.run", "simulation.pause", "simulation.step", "simulation.reset", "measurement.record", "snapshot.save", "snapshot.compare"],
      "instrumentIds": ["particle-view", "qk-meter", "table", "history", "replay"],
      "curiosityHook": { "zh-CN": "压缩、升温和催化剂为什么会产生完全不同的结果？", "en": "Why do compression, heating, and a catalyst produce fundamentally different results?" }
    },
    {
      "id": "sandbox",
      "kind": "free-sandbox",
      "title": { "zh-CN": "反应器沙盒", "en": "Reactor Sandbox" },
      "sceneIds": ["control-equilibrium"],
      "freedomLevel": "F2",
      "allowedCommands": ["object.add", "object.remove", "object.place", "object.configure", "simulation.run", "simulation.pause", "simulation.step", "simulation.reset", "measurement.record", "snapshot.save", "snapshot.compare"],
      "instrumentIds": ["particle-view", "qk-meter", "table", "history", "comparison", "replay"],
      "curiosityHook": { "zh-CN": "自由改变装料量、体积、温度和催化剂，能找到不同但等效的平衡方案吗？", "en": "Can different feed, volume, temperature, and catalyst choices reach equivalent equilibria?" }
    },
    {
      "id": "signal",
      "kind": "scenario-challenge",
      "title": { "zh-CN": "安全生产挑战", "en": "Safe Production Challenge" },
      "sceneIds": ["control-equilibrium"],
      "freedomLevel": "F2",
      "allowedCommands": ["object.add", "object.remove", "object.place", "object.configure", "simulation.run", "simulation.pause", "simulation.step", "simulation.reset", "measurement.record", "snapshot.save", "snapshot.compare"],
      "instrumentIds": ["particle-view", "qk-meter", "table", "history", "comparison", "replay"],
      "curiosityHook": { "zh-CN": "如何增加 NO₂ 的物质的量，同时把它的浓度控制在安全线以下？", "en": "How can you increase the amount of NO₂ while keeping its concentration below a safety limit?" },
      "challenge": {
        "id": "safe-no2-batch",
        "title": { "zh-CN": "安全 NO₂ 批次", "en": "Safe NO₂ Batch" },
        "goal": { "zh-CN": "达到平衡后 NO₂ 不少于 0.60 mol、浓度不高于 0.50 mol/L，且温度不高于 318 K。", "en": "At equilibrium, produce at least 0.60 mol NO₂, keep concentration at or below 0.50 mol/L, and temperature at or below 318 K." },
        "success": [
          { "metric": "no2-amount", "operator": "gte", "value": 0.6 },
          { "metric": "no2-concentration", "operator": "lte", "value": 0.5 },
          { "metric": "temperature", "operator": "lte", "value": 318 }
        ],
        "attemptPolicy": { "maxAttempts": 4, "retry": "after-feedback" }
      }
    }
  ],
  "instruments": [
    { "id": "particle-view", "kind": "probe", "title": { "zh-CN": "粒子模型", "en": "Particle Model" } },
    { "id": "qk-meter", "kind": "comparison", "title": { "zh-CN": "Q/K 比较器", "en": "Q/K Comparator" } },
    { "id": "table", "kind": "table", "title": { "zh-CN": "组成数据", "en": "Composition Data" } },
    { "id": "history", "kind": "annotation", "title": { "zh-CN": "条件记录", "en": "Condition History" } },
    { "id": "comparison", "kind": "comparison", "title": { "zh-CN": "方案快照", "en": "Setup Snapshot" } },
    { "id": "replay", "kind": "replay", "title": { "zh-CN": "平衡过程回放", "en": "Equilibrium Replay" } }
  ]
}
