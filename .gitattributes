# Signed rule bundles are byte-exact artifacts. Never rewrite their line endings.
rules/**/*.cjs -text

# Deployment scripts run in POSIX containers and servers.
*.sh text eol=lf

# Courseware module integrity is byte-exact across Windows authoring and Linux builds.
packages/courseware-ui-kit/** text eol=lf
packages/courseware-domain-packs/** text eol=lf
templates/courseware/** text eol=lf
plugins/gamehub/templates/courseware/** text eol=lf

# Generated third-party browser code contains intentional spaces inside string literals.
extensions/vscode/media/gamehub.js -whitespace

# QA protocol snapshots and fixtures are hashed as byte-exact cross-platform artifacts.
apps/api/src/researcher-qa-protocol/** text eol=lf
tests/platform/fixtures/researcher-qa/** text eol=lf
