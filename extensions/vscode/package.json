{
  "name": "gamehub-agent",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.4.0",
  "publisher": "gamehub-local",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./gamehub-extension.cjs",
  "gamehub": {
    "permissionSetVersion": 1,
    "permissions": [
      "network:mooyu.fun",
      "secret-storage:account-session",
      "read:user-selected-courseware-project",
      "write:user-selected-courseware-project",
      "listen:loopback-courseware-preview"
    ]
  },
  "activationEvents": [
    "onCommand:gamehub.open",
    "onCommand:gamehub.checkForUpdates",
    "onCommand:gamehub.coursewareInit",
    "onCommand:gamehub.coursewareInspect",
    "onCommand:gamehub.coursewareDoctor",
    "onCommand:gamehub.coursewarePreview",
    "onCommand:gamehub.coursewareTest",
    "onCommand:gamehub.coursewareBuild",
    "onCommand:gamehub.coursewarePackage",
    "onView:gamehub.platform"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gamehub.open",
        "title": "%command.open%"
      },
      {
        "command": "gamehub.openBrowser",
        "title": "%command.openBrowser%",
        "icon": "$(globe)"
      },
      {
        "command": "gamehub.checkForUpdates",
        "title": "%command.checkUpdates%",
        "icon": "$(sync)"
      },
      {
        "command": "gamehub.coursewareInit",
        "title": "%command.coursewareInit%"
      },
      {
        "command": "gamehub.coursewareInspect",
        "title": "%command.coursewareInspect%"
      },
      {
        "command": "gamehub.coursewareDoctor",
        "title": "%command.coursewareDoctor%"
      },
      {
        "command": "gamehub.coursewarePreview",
        "title": "%command.coursewarePreview%"
      },
      {
        "command": "gamehub.coursewareTest",
        "title": "%command.coursewareTest%"
      },
      {
        "command": "gamehub.coursewareBuild",
        "title": "%command.coursewareBuild%"
      },
      {
        "command": "gamehub.coursewarePackage",
        "title": "%command.coursewarePackage%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gamehub",
          "title": "%viewContainer.title%",
          "icon": "media/arcade.svg"
        }
      ]
    },
    "views": {
      "gamehub": [
        {
          "type": "webview",
          "id": "gamehub.platform",
          "name": "%view.name%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gamehub.openBrowser",
          "when": "view == gamehub.platform",
          "group": "navigation"
        },
        {
          "command": "gamehub.checkForUpdates",
          "when": "view == gamehub.platform",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "gamehub.apiUrl": {
          "type": "string",
          "default": "https://mooyu.fun",
          "scope": "application",
          "description": "%configuration.apiUrl%"
        },
        "gamehub.browserUrl": {
          "type": "string",
          "default": "https://mooyu.fun/",
          "scope": "application",
          "description": "%configuration.browserUrl%"
        },
        "gamehub.runtimeDomain": {
          "type": "string",
          "default": "runtime.mooyu.fun",
          "scope": "application",
          "description": "%configuration.runtimeDomain%"
        },
        "gamehub.autoUpdate": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%configuration.autoUpdate%"
        },
        "gamehub.coursewarePlaywrightModule": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%configuration.coursewarePlaywrightModule%"
        }
      }
    }
  }
}
