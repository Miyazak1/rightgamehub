{
  "name": "gamehub-agent",
  "displayName": "GameHub for AI Coding",
  "description": "在 VS Code 或 Cursor 侧栏中发现、游玩和发布轻量游戏。",
  "version": "0.3.20",
  "publisher": "gamehub-local",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./gamehub-extension.cjs",
  "activationEvents": [
    "onCommand:gamehub.open",
    "onCommand:gamehub.checkForUpdates",
    "onView:gamehub.platform"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gamehub.open",
        "title": "GameHub: 打开游戏平台"
      },
      {
        "command": "gamehub.openBrowser",
        "title": "GameHub: 在内置浏览器打开",
        "icon": "$(globe)"
      },
      {
        "command": "gamehub.checkForUpdates",
        "title": "GameHub: 检查更新",
        "icon": "$(sync)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gamehub",
          "title": "GameHub",
          "icon": "media/arcade.svg"
        }
      ]
    },
    "views": {
      "gamehub": [
        {
          "type": "webview",
          "id": "gamehub.platform",
          "name": "GameHub"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gamehub.openBrowser",
          "when": "view == gamehub.platform",
          "group": "navigation"
        },
        {
          "command": "gamehub.checkForUpdates",
          "when": "view == gamehub.platform",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "GameHub",
      "properties": {
        "gamehub.apiUrl": {
          "type": "string",
          "default": "https://mooyu.fun",
          "scope": "application",
          "description": "GameHub API 地址。默认连接正式服务。"
        },
        "gamehub.browserUrl": {
          "type": "string",
          "default": "https://mooyu.fun/",
          "scope": "application",
          "description": "无法使用侧栏时打开的 GameHub 页面。"
        },
        "gamehub.runtimeDomain": {
          "type": "string",
          "default": "runtime.mooyu.fun",
          "scope": "application",
          "description": "GameHub 隔离 Web 游戏的受信任运行域名。"
        },
        "gamehub.autoUpdate": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "在后台检查、校验并安装 GameHub 稳定版更新；重启编辑器后生效。"
        }
      }
    }
  }
}
