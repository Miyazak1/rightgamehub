{
  "name": "gamehub-agent",
  "displayName": "墨鱼工坊 MOOYU.FUN",
  "description": "在 VS Code 或 Cursor 侧栏中发现、游玩和发布轻量游戏。",
  "version": "0.3.45",
  "publisher": "gamehub-local",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./gamehub-extension.cjs",
  "activationEvents": [
    "onCommand:gamehub.open",
    "onCommand:gamehub.checkForUpdates",
    "onView:gamehub.platform"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gamehub.open",
        "title": "墨鱼工坊：打开游戏平台"
      },
      {
        "command": "gamehub.openBrowser",
        "title": "墨鱼工坊：在内置浏览器打开",
        "icon": "$(globe)"
      },
      {
        "command": "gamehub.checkForUpdates",
        "title": "墨鱼工坊：检查更新",
        "icon": "$(sync)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gamehub",
          "title": "墨鱼工坊",
          "icon": "media/arcade.svg"
        }
      ]
    },
    "views": {
      "gamehub": [
        {
          "type": "webview",
          "id": "gamehub.platform",
          "name": "墨鱼工坊"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gamehub.openBrowser",
          "when": "view == gamehub.platform",
          "group": "navigation"
        },
        {
          "command": "gamehub.checkForUpdates",
          "when": "view == gamehub.platform",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "墨鱼工坊",
      "properties": {
        "gamehub.apiUrl": {
          "type": "string",
          "default": "https://mooyu.fun",
          "scope": "application",
          "description": "墨鱼工坊 API 地址。默认连接正式服务。"
        },
        "gamehub.browserUrl": {
          "type": "string",
          "default": "https://mooyu.fun/",
          "scope": "application",
          "description": "无法使用侧栏时打开的墨鱼工坊页面。"
        },
        "gamehub.runtimeDomain": {
          "type": "string",
          "default": "runtime.mooyu.fun",
          "scope": "application",
          "description": "墨鱼工坊隔离 Web 游戏的受信任运行域名。"
        },
        "gamehub.autoUpdate": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "在后台检查、校验并安装墨鱼工坊稳定版更新；重启编辑器后生效。"
        }
      }
    }
  }
}
