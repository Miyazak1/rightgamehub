{
  "name": "gamehub-dsh-plugin",
  "version": "0.1.6",
  "description": "GameHub game discovery, publishing and play experience for DeepSeek Harness",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md"
  ],
  "homepage": "https://mooyu.fun",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent",
    "games",
    "gamehub"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gamehub/host-contract": "workspace:*",
    "@gamehub/platform-api-client": "workspace:*",
    "@gamehub/platform-client": "workspace:*",
    "esbuild": "0.24.2"
  }
}
