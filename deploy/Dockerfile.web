FROM node:22-bookworm-slim AS web-build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY extensions/harness/package.json extensions/harness/package.json
COPY extensions/vscode/package.json extensions/vscode/package.json
COPY packages/platform-client/package.json packages/platform-client/package.json
COPY packages/multiplayer-protocol/package.json packages/multiplayer-protocol/package.json
COPY packages/platform-api-client/package.json packages/platform-api-client/package.json
COPY packages/host-contract/package.json packages/host-contract/package.json
COPY packages/player-core/package.json packages/player-core/package.json
RUN pnpm install --frozen-lockfile --filter @gamehub/web... --filter gamehub-dsh-plugin...
COPY apps/web apps/web
COPY packages/platform-client packages/platform-client
COPY packages/multiplayer-protocol packages/multiplayer-protocol
COPY packages/platform-api-client packages/platform-api-client
COPY packages/host-contract packages/host-contract
COPY packages/player-core packages/player-core
COPY extensions/harness extensions/harness
COPY extensions/vscode extensions/vscode
COPY plugins plugins
COPY poc/m0 poc/m0
COPY .agents .agents
COPY .claude-plugin .claude-plugin
COPY scripts/build-extension.mjs scripts/build-extension.mjs
COPY scripts/build-harness.mjs scripts/build-harness.mjs
COPY scripts/package-vscode-extension.mjs scripts/package-vscode-extension.mjs
COPY scripts/prepare-agent-downloads.mjs scripts/prepare-agent-downloads.mjs
ARG VITE_RUNTIME_DOMAIN
ENV VITE_RUNTIME_DOMAIN=$VITE_RUNTIME_DOMAIN
RUN node scripts/build-extension.mjs && node scripts/package-vscode-extension.mjs && node scripts/build-harness.mjs && npm pack ./extensions/harness --ignore-scripts --pack-destination ./artifacts --cache ./.runtime/npm-cache && node scripts/prepare-agent-downloads.mjs
RUN pnpm --filter @gamehub/web build

FROM caddy:2-builder-alpine AS caddy-build
RUN xcaddy build --with github.com/caddy-dns/alidns@v1.0.29

FROM caddy:2-alpine
COPY --from=caddy-build /usr/bin/caddy /usr/bin/caddy
COPY --from=web-build /app/apps/web/dist /srv/gamehub
COPY deploy/Caddyfile /etc/caddy/Caddyfile
EXPOSE 80 443
