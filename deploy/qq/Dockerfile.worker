# Runtime dependencies are copied from the repository's pinned, installed tree.
FROM node:22.23.2-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
WORKDIR /app
COPY --chown=node:node worker/ /app/
ENV NODE_ENV=production
USER node
CMD ["node", "apps/qq-channel/src/cli.mjs", "/config/config.json", "--run"]
