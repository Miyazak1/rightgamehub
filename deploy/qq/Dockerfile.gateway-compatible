# Local compatibility candidate, derived from the G/J successful login baseline.
# Build context contains only the verified main program and these two scripts.
FROM ghcr.io/napneko/nodenapcat@sha256:9f35df29e9f0a92f737143e123b9159b998c314a573139b5ac0e6bd4ab5af574
USER root
COPY napcat.mjs /app/napcat/napcat.mjs
COPY gateway-entry-compatible.cjs /opt/gateway-entry-compatible.cjs
COPY manage.mjs /opt/manage.mjs
RUN mkdir -p /data && chown 1000:1000 /data
ENV HOME=/data/home NAPCAT_WORKDIR=/data/napcat NAPCAT_QQ_DATA_DIR=""
ENV NAPCAT_DISABLE_MULTI_PROCESS=1 NAPCAT_DISABLE_BYPASS=1 NAPCAT_DISABLE_PIPE=1
ENV PAPER_STUDY_ENABLED=false PAPER_STUDY_WORKER_ENABLED=false PAPER_STUDY_MODELS_ENABLED=false PAPER_STUDY_PUBLISH_ENABLED=false
WORKDIR /app
USER 1000:1000
# Never execute the upstream shell entrypoint.
ENTRYPOINT ["node", "/opt/gateway-entry-compatible.cjs"]
