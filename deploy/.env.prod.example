APP_DOMAIN=example.com
RUNTIME_DOMAIN=runtime.example.com
ACME_EMAIL=ops@example.com
ALIYUN_ACCESS_KEY_ID=replace-with-ram-access-key-id
ALIYUN_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret

POSTGRES_PASSWORD=replace-with-a-long-random-password
OTP_HMAC_KEY=replace-with-at-least-32-random-characters

# Production object storage. ECS obtains short-lived credentials from its
# attached RAM role; do not create or place a permanent OSS AccessKey here.
OBJECT_STORAGE_PROVIDER=aliyun-oss
OSS_REGION=oss-ap-southeast-1
OSS_ENDPOINT=https://oss-ap-southeast-1-internal.aliyuncs.com
OSS_BUCKET=gamehub-prod-sg-mooyu
OSS_ECS_ROLE_NAME=GameHubEcsOssRole

# Optional until the first server-authoritative game is installed. Stage/sign offline with:
# npm run rules:manifest -- keygen <key-id> <private.pem> <public.json>
# npm run rules:manifest -- stage <release-dir> <key-id> <bundle.cjs> <work-id> <mode-key> <ruleset-version> [current-manifest.json|-] [trusted-keys.json|-]
# npm run rules:manifest -- sign <release-dir>/manifest.unsigned.json <private.pem> <release-dir>/manifest.json
# Keep the private key offline. Copy the compact public.json object into this value.
# Leave the path empty before the first install; rules-release.sh sets the current pointer.
RULES_MANIFEST_PATH=
RULES_TRUSTED_KEYS_JSON=

MAIL_FROM='GameHub <login@example.com>'
RESEND_API_KEY=re_replace_me
# Leave empty to allow any valid email to sign in. Creator upload and publish
# access is still granted only after an administrator approves the application.
LOGIN_EMAIL_ALLOWLIST=

# Optional for the first deployment. Email login remains available.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
# Separate GitHub App (not the login OAuth App). Metadata + Contents: read-only.
GITHUB_SOURCE_IMPORT_ENABLED=false
DEEPSEEK_SEARCH_ENABLED=false
DEEPSEEK_FETCH_ENABLED=false
# Tier 1 candidate-value scoring is separately gated and off by default.
RESEARCH_CANDIDATE_ASSESSMENT_ENABLED=false
DEEPSEEK_API_KEY=
# Root key for encrypting Agent provider credentials stored through the admin UI.
# Generate once with: openssl rand -hex 32
AGENT_SECRET_ENCRYPTION_KEY=
AGENT_BLOG_POLL_SECONDS=30
AGENT_BLOG_PROVIDER_TIMEOUT_MS=120000
# Foundation runtime and private blog canary stay independently disabled.
AGENT_RUNTIME_WORKER_ENABLED=false
AGENT_BLOG_PRIVATE_CANARY_ENABLED=false
AGENT_BLOG_PRIVATE_CANARY_PUBLISH_ENABLED=false
# Required only for the explicit preflight and one-shot private-canary profiles.
AGENT_BLOG_PRIVATE_CANARY_AGENT_USER_ID=
# Optional UUID. Set it to make an operator retry idempotent; blank generates one per invocation.
AGENT_BLOG_PRIVATE_CANARY_REQUEST_ID=
# Required only when generating an immutable acceptance report for an existing private draft Run.
AGENT_BLOG_PRIVATE_CANARY_DRAFT_RUN_ID=
AGENT_BLOG_PRIVATE_CANARY_PROVIDER=deepseek
AGENT_BLOG_PRIVATE_CANARY_MODEL_ID=deepseek-flash
AGENT_BLOG_PRIVATE_CANARY_DAILY_RUN_LIMIT=1
AGENT_BLOG_PRIVATE_CANARY_MONTHLY_PROVIDER_CALL_LIMIT=12
AGENT_BLOG_PRIVATE_CANARY_MONTHLY_COST_MICROUSD_LIMIT=1000000
AGENT_BLOG_PRIVATE_CANARY_FAILURE_THRESHOLD=2
# Activate only after the admin panel shows three consecutive private-shadow
# acceptance passes. Also add agent-blog-private-scheduler to COMPOSE_PROFILES.
AGENT_BLOG_PRIVATE_SCHEDULE_ENABLED=false
AGENT_BLOG_PRIVATE_SCHEDULE_POLL_MS=30000
DEEPSEEK_SEARCH_TIMEOUT_MS=12000
DEEPSEEK_FETCH_TIMEOUT_MS=15000
RESEARCH_CANDIDATE_ASSESSMENT_MODEL=deepseek-chat
RESEARCH_CANDIDATE_ASSESSMENT_TIMEOUT_MS=45000
RESEARCH_CANDIDATE_ASSESSMENT_MAX_PER_RUN=6
# Update these integer USD-micro snapshots when the provider's public list price changes.
DEEPSEEK_SEARCH_PRICE_USD_MICROS_PER_REQUEST=750
DEEPSEEK_FETCH_PRICE_USD_MICROS_PER_REQUEST=750
RESEARCH_CANDIDATE_ASSESSMENT_PRICE_USD_MICROS_PER_REQUEST=3000
# Server-to-worker bearer secret (32+ bytes). Keep disabled until a compatible worker is deployed.
RESEARCHER_WORKER_ENABLED=false
RESEARCHER_WORKER_TOKEN=
RESEARCHER_WORKER_ID=researcher-worker-1
RESEARCHER_LEASE_SECONDS=120
# API-side reservation identity. The Compose worker inherits this exact model.
RESEARCHER_PROVIDER_ID=deepseek-researcher
RESEARCHER_PROVIDER_MODEL=deepseek-chat
# Conservative maximum charge reserved per model job (USD micros; $0.02 by default).
RESEARCHER_ESTIMATED_COST_USD_MICROS_PER_JOB=20000
# Only the optional researcher profile receives this provider key.
RESEARCHER_DEEPSEEK_API_KEY=
RESEARCHER_PLATFORM_TIMEOUT_MS=15000
RESEARCHER_DEEPSEEK_TIMEOUT_MS=120000
RESEARCHER_DEEPSEEK_MAX_TOKENS=6000
RESEARCHER_WORKER_LEASE_SECONDS=300
RESEARCHER_WORKER_HEARTBEAT_SECONDS=60
RESEARCHER_WORKER_POLL_MS=3000
RESEARCH_TOPIC_MAX_ACTIVE_RUNS_PER_ACCOUNT=1
RESEARCHER_MAX_ACTIVE_JOBS_PER_ACCOUNT=1
RESEARCH_TOPIC_MAX_ACTIVE_RUNS_GLOBAL=1
RESEARCHER_MAX_ACTIVE_JOBS_GLOBAL=1
# Hard monthly pre-send budgets (UTC calendar month). 1 USD = 1,000,000 micros.
RESEARCH_MAX_BILLABLE_REQUESTS_PER_ACCOUNT_MONTH=100
RESEARCH_MAX_PROVIDER_COST_USD_MICROS_PER_ACCOUNT_MONTH=1000000
RESEARCH_MAX_BILLABLE_REQUESTS_GLOBAL_MONTH=1000
RESEARCH_MAX_PROVIDER_COST_USD_MICROS_GLOBAL_MONTH=10000000
# Cross-instance provider circuit breaker for retryable failures.
RESEARCH_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
RESEARCH_PROVIDER_CIRCUIT_WINDOW_SECONDS=300
RESEARCH_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=300
RESEARCH_PROVIDER_CIRCUIT_PROBE_SECONDS=120
RESEARCH_ACTION_RECOVERY_GRACE_SECONDS=120
SOURCE_BUILD_ENABLED=false
# Required when SOURCE_BUILD_ENABLED=true. Use the deployed source-builder image digest.
SOURCE_BUILDER_IMAGE_DIGEST=
# Rule source builds are separate from GitHub source builds. Keep disabled until
# deploy/Dockerfile.rule-builder has been built and this digest is pinned.
RULE_BUILD_ENABLED=false
RULE_BUILDER_IMAGE_DIGEST=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=https://example.com/creator/import
# Store PEM newlines as literal \\n when using this env file.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Optional Wikimedia contact identity for automated Guess Baike requests.
GUESS_BAIKE_WIKIPEDIA_USER_AGENT='GameHub-GuessBaikeBot/0.3 (https://example.com/; automated daily puzzle) Node.js'

# Save storage protection (mandatory in production; probe is in save-operations profile).
# Keep cloud saves isolated; local saves work without this service.
CLOUD_SAVE_ENABLED=false
# Community rollout is independent of cloud saves and game publishing.
PUBLIC_COMMUNITY_RELEASE=false
COMMUNITY_ENABLED=false
COMMUNITY_POSTING_ENABLED=false
COMMUNITY_IMAGES_ENABLED=false
COMMUNITY_MEDIA_BUDGET_BYTES=2147483648
# Images additionally require: docker compose --profile community-images ... up -d community-image
SAVE_STORAGE_MAX_AGE_SECONDS=90
SAVE_STORAGE_MIN_FREE_BYTES=1073741824
SAVE_STORAGE_MAX_USED_PERCENT=85
SAVE_STORAGE_MIN_FREE_INODE_PERCENT=5
SAVE_STORAGE_MAX_WAL_BYTES=2147483648

# Deployment residue maintenance. Cleanup runs only after compose reports a
# healthy deployment and never removes Docker volumes or local backups.
DEPLOY_WAIT_SECONDS=240
DEPLOY_PRUNE=true
PRUNE_AGE_HOURS=168

# Share URLs use APP_DOMAIN through compose; payloads expire after 30 days.
