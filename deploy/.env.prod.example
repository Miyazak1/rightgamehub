APP_DOMAIN=example.com
RUNTIME_DOMAIN=runtime.example.com
ACME_EMAIL=ops@example.com
ALIYUN_ACCESS_KEY_ID=replace-with-ram-access-key-id
ALIYUN_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret

POSTGRES_PASSWORD=replace-with-a-long-random-password
OTP_HMAC_KEY=replace-with-at-least-32-random-characters

# Optional until the first server-authoritative game is installed. Stage/sign offline with:
# npm run rules:manifest -- keygen <key-id> <private.pem> <public.json>
# npm run rules:manifest -- stage <release-dir> <key-id> <bundle.cjs> <work-id> <mode-key> <ruleset-version> [current-manifest.json|-] [trusted-keys.json|-]
# npm run rules:manifest -- sign <release-dir>/manifest.unsigned.json <private.pem> <release-dir>/manifest.json
# Keep the private key offline. Copy the compact public.json object into this value.
# Leave the path empty before the first install; rules-release.sh sets the current pointer.
RULES_MANIFEST_PATH=
RULES_TRUSTED_KEYS_JSON=

MAIL_FROM='GameHub <login@example.com>'
RESEND_API_KEY=re_replace_me
# Leave empty to allow any valid email to sign in. Creator upload and publish
# access is still granted only after an administrator approves the application.
LOGIN_EMAIL_ALLOWLIST=

# Optional for the first deployment. Email login remains available.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
# Separate GitHub App (not the login OAuth App). Metadata + Contents: read-only.
GITHUB_SOURCE_IMPORT_ENABLED=false
SOURCE_BUILD_ENABLED=false
# Required when SOURCE_BUILD_ENABLED=true. Use the deployed source-builder image digest.
SOURCE_BUILDER_IMAGE_DIGEST=
# Rule source builds are separate from GitHub source builds. Keep disabled until
# deploy/Dockerfile.rule-builder has been built and this digest is pinned.
RULE_BUILD_ENABLED=false
RULE_BUILDER_IMAGE_DIGEST=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=https://example.com/#/creator/import
# Store PEM newlines as literal \\n when using this env file.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Optional Wikimedia contact identity for automated Guess Baike requests.
GUESS_BAIKE_WIKIPEDIA_USER_AGENT='GameHub-GuessBaikeBot/0.3 (https://example.com/; automated daily puzzle) Node.js'
