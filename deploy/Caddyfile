{
  email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
  tls {
    dns alidns {
      access_key_id {env.ALIYUN_ACCESS_KEY_ID}
      access_key_secret {env.ALIYUN_ACCESS_KEY_SECRET}
    }
  }
  encode zstd gzip

  @private_routes path /account* /creator* /admin* /play/* /challenge/* /s/* /install* /mcp-app* /mcp-widget/* /community/me* /community/bookmarks* /community/review*
  header @private_routes X-Robots-Tag "noindex, nofollow"

  handle /health {
    reverse_proxy api:3090
  }
  handle /ready {
    reverse_proxy api:3090
  }

  handle /mcp {
    reverse_proxy api:3090
  }

  handle /mcp/change-radar {
    reverse_proxy api:3090
  }

  handle /mcp-widget/* {
    reverse_proxy api:3090
  }

  # MCP clients probe OAuth discovery even when a public server does not
  # require authentication. Let the API return a real 404 instead of the SPA.
  handle /.well-known/oauth-* {
    reverse_proxy api:3090
  }

  handle /robots.txt {
    reverse_proxy api:3090
  }

  handle /sitemap.xml {
    reverse_proxy api:3090
  }

  handle /v1/realtime {
    reverse_proxy realtime:3093
  }

  handle /v1/* {
    reverse_proxy api:3090
  }

  handle /w/* {
    reverse_proxy api:3090
  }

  handle /discover/c/* {
    reverse_proxy api:3090
  }

  handle /blog/* {
    reverse_proxy api:3090
  }

  # Vite filenames are content-addressed. Cache existing bundles permanently,
  # but return a real 404 for a removed bundle instead of the SPA HTML shell.
  handle /assets/* {
    root * /srv/gamehub
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  # mooyu-desktop-downloads begin
  @desktop_downloads path /downloads/desktop /downloads/desktop/*
  handle @desktop_downloads {
    uri strip_prefix /downloads/desktop
    root * /srv/desktop-downloads
    header {
      Cache-Control "no-store"
      X-Content-Type-Options "nosniff"
    }
    @desktop_method not method GET HEAD
    handle @desktop_method {
      respond "Method not allowed" 405
    }
    @desktop_manifest path /manifest.json
    handle @desktop_manifest {
      file_server
    }
    @desktop_release path_regexp desktop_release ^/[0-9]+\.[0-9]+\.[0-9]+-preview\.[1-9][0-9]*/(MooyuWorkshop-[0-9]+\.[0-9]+\.[0-9]+-preview\.[1-9][0-9]*-x64-Setup\.exe|SHA256SUMS\.txt|release\.json)$
    handle @desktop_release {
      header Cache-Control "public, max-age=31536000, immutable" {
        match status 200 206 304
      }
      @desktop_exe path *.exe
      header @desktop_exe {
        Content-Type "application/octet-stream"
        Content-Disposition "attachment"
        match status 200 206 304
      }
      file_server
    }
    handle {
      respond "Not found" 404
    }
  }
  # mooyu-desktop-downloads end

  # Dedicated shell used only by the MCP Apps widget. Keep the main site
  # protected from framing and allow only the known OpenAI sandbox surfaces.
  handle /mcp-app {
    root * /srv/gamehub
    try_files /index.html
    header {
      Cache-Control "no-store"
      Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-src https://*.{$RUNTIME_DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://web-sandbox.oaiusercontent.com https://*.web-sandbox.oaiusercontent.com https://chatgpt.com https://chat.openai.com vscode-webview: codex: codex-sandbox:"
      Referrer-Policy "no-referrer"
      X-Content-Type-Options "nosniff"
      Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=()"
    }
    file_server
  }

  # First-party learning library previews are self-contained courseware files.
  # Inline scripts are allowed only in this narrow path; public third-party
  # embeds continue to use the isolated runtime domain and release gateway.
  handle /learning/courseware/* {
    root * /srv/gamehub
    try_files {path} {path}/index.html
    header {
      Cache-Control "public, max-age=300"
      Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' vscode-webview:"
      Referrer-Policy "no-referrer"
      X-Content-Type-Options "nosniff"
      Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=()"
    }
    file_server
  }

  handle {
    root * /srv/gamehub
    try_files {path} /index.html
    header {
      Cache-Control "no-store"
      Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-src https://*.{$RUNTIME_DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' vscode-webview:"
      Referrer-Policy "no-referrer"
      X-Content-Type-Options "nosniff"
      Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=()"
    }
    file_server
  }
}

www.{$APP_DOMAIN} {
  tls {
    dns alidns {
      access_key_id {env.ALIYUN_ACCESS_KEY_ID}
      access_key_secret {env.ALIYUN_ACCESS_KEY_SECRET}
    }
  }
  redir https://{$APP_DOMAIN}{uri} permanent
}

*.{$RUNTIME_DOMAIN} {
  tls {
    dns alidns {
      access_key_id {env.ALIYUN_ACCESS_KEY_ID}
      access_key_secret {env.ALIYUN_ACCESS_KEY_SECRET}
    }
  }
  reverse_proxy runtime:3092
}
