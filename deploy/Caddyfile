{
  email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
  tls {
    dns alidns {
      access_key_id {env.ALIYUN_ACCESS_KEY_ID}
      access_key_secret {env.ALIYUN_ACCESS_KEY_SECRET}
    }
  }
  encode zstd gzip

  @private_routes path /account* /creator* /admin* /play/* /challenge/* /s/* /install* /mcp-app* /community/me* /community/bookmarks* /community/review*
  header @private_routes X-Robots-Tag "noindex, nofollow"

  handle /health {
    reverse_proxy api:3090
  }
  handle /ready {
    reverse_proxy api:3090
  }

  handle /mcp {
    reverse_proxy api:3090
  }

  # MCP clients probe OAuth discovery even when a public server does not
  # require authentication. Let the API return a real 404 instead of the SPA.
  handle /.well-known/oauth-* {
    reverse_proxy api:3090
  }

  handle /robots.txt {
    reverse_proxy api:3090
  }

  handle /sitemap.xml {
    reverse_proxy api:3090
  }

  handle /v1/realtime {
    reverse_proxy realtime:3093
  }

  handle /v1/* {
    reverse_proxy api:3090
  }

  handle /w/* {
    reverse_proxy api:3090
  }

  handle /discover/c/* {
    reverse_proxy api:3090
  }

  # Dedicated shell used only by the MCP Apps widget. Keep the main site
  # protected from framing and allow only the known OpenAI sandbox surfaces.
  handle /mcp-app {
    root * /srv/gamehub
    try_files /index.html
    header {
      Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-src https://*.{$RUNTIME_DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://web-sandbox.oaiusercontent.com https://chatgpt.com https://chat.openai.com vscode-webview: codex:"
      Referrer-Policy "no-referrer"
      X-Content-Type-Options "nosniff"
      Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=()"
    }
    file_server
  }

  handle {
    root * /srv/gamehub
    try_files {path} /index.html
    header {
      Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-src https://*.{$RUNTIME_DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' vscode-webview:"
      Referrer-Policy "no-referrer"
      X-Content-Type-Options "nosniff"
      Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=()"
    }
    file_server
  }
}

www.{$APP_DOMAIN} {
  tls {
    dns alidns {
      access_key_id {env.ALIYUN_ACCESS_KEY_ID}
      access_key_secret {env.ALIYUN_ACCESS_KEY_SECRET}
    }
  }
  redir https://{$APP_DOMAIN}{uri} permanent
}

*.{$RUNTIME_DOMAIN} {
  tls {
    dns alidns {
      access_key_id {env.ALIYUN_ACCESS_KEY_ID}
      access_key_secret {env.ALIYUN_ACCESS_KEY_SECRET}
    }
  }
  reverse_proxy runtime:3092
}
