FROM node:22-bookworm-slim AS dependencies
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/realtime/package.json apps/realtime/package.json
COPY packages/multiplayer-protocol/package.json packages/multiplayer-protocol/package.json
RUN pnpm install --frozen-lockfile --filter @gamehub/realtime...

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/apps/realtime/node_modules ./apps/realtime/node_modules
COPY --chown=node:node apps/realtime ./apps/realtime
COPY --chown=node:node packages/multiplayer-protocol ./packages/multiplayer-protocol
USER node
EXPOSE 3093
CMD ["node", "apps/realtime/src/server.mjs"]
