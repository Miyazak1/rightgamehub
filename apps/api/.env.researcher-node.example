# Copy this file outside the repository as your local node configuration.
# The platform shows RESEARCHER_NODE_TOKEN only once when you create a node.
RESEARCHER_PLATFORM_URL=https://mooyu.fun
RESEARCHER_NODE_TOKEN=

# This key stays on the user's computer. Never upload or commit it.
RESEARCHER_DEEPSEEK_API_KEY=
RESEARCHER_PROVIDER_ID=deepseek-researcher
RESEARCHER_DEEPSEEK_MODEL=deepseek-chat

RESEARCHER_PLATFORM_TIMEOUT_MS=15000
RESEARCHER_DEEPSEEK_TIMEOUT_MS=120000
RESEARCHER_DEEPSEEK_MAX_TOKENS=6000
RESEARCHER_WORKER_LEASE_SECONDS=300
RESEARCHER_WORKER_HEARTBEAT_SECONDS=60
RESEARCHER_WORKER_POLL_MS=3000
