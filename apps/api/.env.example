NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3090
DATABASE_URL=postgresql://gamehub:replace-me@127.0.0.1:54329/gamehub
DATABASE_SSL=false
OTP_HMAC_KEY=replace-with-at-least-32-random-characters
# Optional independent secret. Defaults to OTP_HMAC_KEY when omitted.
ROOM_CODE_HMAC_KEY=replace-with-at-least-32-random-characters
REDIS_URL=redis://127.0.0.1:63799
REALTIME_PUBLIC_URL=ws://127.0.0.1:3093/v1/realtime
REALTIME_TICKET_TTL_SECONDS=30
# GitHub OAuth App. Web OAuth is primary; Device Flow remains the fallback.
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://127.0.0.1:3090/v1/auth/github/web/callback
# Independent GitHub App for read-only source import. Keep disabled until all values are configured.
GITHUB_SOURCE_IMPORT_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=http://127.0.0.1:5173/#/creator/import
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
QUARANTINE_ROOT=.runtime/platform/quarantine
COVER_ROOT=.runtime/platform/covers
RUNTIME_ROOT=.runtime/platform/published
VALIDATOR_ROOT=.runtime/platform/validator
VALIDATOR_EXECUTION_MODE=local
STORAGE_WARN_PERCENT=70
STORAGE_BLOCK_PERCENT=85
STORAGE_MONITOR_INTERVAL_SECONDS=60
RUNTIME_PORT=3092
RUNTIME_DOMAIN=localhost
RUNTIME_SCHEME=http
RUNTIME_PUBLIC_PORT=3092
